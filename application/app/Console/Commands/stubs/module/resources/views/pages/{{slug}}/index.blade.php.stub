<?php

use Livewire\Attributes\Title;
use Livewire\Attributes\Layout;
use Livewire\Component;

new #[Title('{{name}}')] #[Layout('layouts.app')] class extends Component {
    public function mount(): void
    {
        abort_unless(auth()->user()->can('{{permission}}.view'), 403);
    }
}; ?>
<div class="space-y-6">
    <div>
        <flux:heading size="xl" class="font-extrabold tracking-tight">{{ __('{{name}}') }}</flux:heading>
        <flux:subheading>{{ __('Manage {{name}} records.') }}</flux:subheading>
    </div>
</div>
